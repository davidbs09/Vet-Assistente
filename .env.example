# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or in their web hosting.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://www.ajudavoce.com.br).
APP_URL="https://www.ajudavoce.com.br"

# E-mail do administrador. Esse cadastro entra já ativo e pode liberar os demais.
VITE_ADMIN_EMAIL=""
