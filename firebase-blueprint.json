{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "A veterinary patient (dog or cat).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "species": { "type": "string", "enum": ["dog", "cat"] },
        "breed": { "type": "string" },
        "weight": { "type": "number" },
        "ownerName": { "type": "string" },
        "ownerPhone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "species", "weight", "createdBy"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "A veterinary consultation record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "symptoms": { "type": "string" },
        "diagnosis": { "type": "string" },
        "treatment": { "type": "string" },
        "examUrls": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["patientId", "date", "createdBy"]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "A generated prescription for a patient.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "consultationId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "medications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "dosage": { "type": "string" },
              "frequency": { "type": "string" },
              "duration": { "type": "string" }
            }
          }
        },
        "createdBy": { "type": "string" }
      },
      "required": ["patientId", "date", "createdBy"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "Veterinary user profile stored in Firestore. Password lives in Firebase Auth; access is gated by status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "crmv": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["pending", "active", "revoked"] },
        "mustResetPassword": { "type": "boolean" },
        "passwordResetAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "activatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayName", "role", "status"]
    },
    "PasswordReset": {
      "title": "PasswordReset",
      "description": "Hashed-email lookup used before login when the admin emptied the account password.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "requestedBy": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "Single active session record for concurrent login prevention.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "email": { "type": "string" },
        "userId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "lastActive": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "email", "userId", "isActive"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Collection of veterinary patients."
    },
    "/consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "Collection of consultation records."
    },
    "/prescriptions/{prescriptionId}": {
      "schema": "Prescription",
      "description": "Collection of prescriptions."
    },
    "/users/{userId}": {
      "schema": "AppUser",
      "description": "User profiles created on register. Pending until an admin activates the account. mustResetPassword blocks access until a new password is set."
    },
    "/passwordResets/{hash}": {
      "schema": "PasswordReset",
      "description": "SHA-256(email) documents that let the login screen detect an emptied password without listing users."
    },
    "/userSessions/{userId}": {
      "schema": "UserSession",
      "description": "Single active session per user to enforce one login at a time."
    }
  }
}
