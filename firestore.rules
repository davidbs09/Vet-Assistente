rules_version = '2';
// Version: 1.2 - Simplified for stability
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return isAuthenticated() && data.createdBy == request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }

    function isActiveUser() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().status == 'active';
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin()
        || (isAuthenticated()
            && request.auth.uid == userId
            && request.resource.data.status == resource.data.status
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /patients/{patientId} {
      allow read: if isActiveUser() && (resource == null || isOwner(resource.data));
      allow create: if isActiveUser() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActiveUser() && isOwner(resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isActiveUser() && isOwner(resource.data);
    }

    match /consultations/{consultationId} {
      allow read: if isActiveUser() && (resource == null || isOwner(resource.data));
      allow create: if isActiveUser() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActiveUser() && isOwner(resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isActiveUser() && isOwner(resource.data);
    }

    match /userSessions/{userId} {
      allow read, write: if isActiveUser() && request.auth.uid == userId;
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
